# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aegis:aegis_dev@localhost:5432/aegis_db

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C0123456789

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── NVD ───────────────────────────────────────────────────────────────────────
NVD_API_KEY=your-nvd-api-key

# ── AWS (S3 + ECS) ────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-secret
AWS_REGION=us-east-1
S3_BUCKET=aegis-sbom-artifacts

# ── ECS Validator ─────────────────────────────────────────────────────────────
ECS_CLUSTER=aegis-cluster
ECS_TASK_DEFINITION=aegis-validator:1
ECS_SUBNETS=subnet-abc123,subnet-def456
ECS_SECURITY_GROUPS=sg-abc123

# ── Jina Reader (JS-rendered page fallback) ───────────────────────────────────
JINA_READER_URL=https://r.jina.ai

# ── GitHub (license resolution fallback) ──────────────────────────────────────
GITHUB_TOKEN=ghp_...

# ── Agent ─────────────────────────────────────────────────────────────────────
FEED_POLL_INTERVAL_MINUTES=30

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
